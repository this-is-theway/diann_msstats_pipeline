Bootstrap: docker
From: python:3.12-slim-bookworm

# =============================================================================
#  Python + pandas + pyarrow for the DIANN_TO_MSSTATS Nextflow process
#  (reads DIA-NN report.parquet, writes msstats.csv / protein_map.csv)
#
#  Build:
#    apptainer build python_pandas_pyarrow.sif python_pandas_pyarrow.def
#
#  diann_to_msstats.py lives in the pipeline's bin/ directory; Nextflow puts
#  bin/ on PATH inside the container, so the script only needs a
#  `#!/usr/bin/env python3` shebang and the executable bit (chmod +x).
# =============================================================================

%arguments
    PANDAS_VERSION=2.2.3
    PYARROW_VERSION=18.1.0
    NUMPY_VERSION=2.1.3

%help
    Python environment for converting DIA-NN report.parquet into MSstats input.
    Usage:  apptainer exec python_pandas_pyarrow.sif python3 -c "import pandas, pyarrow"

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1
    # avoid writes into a read-only $HOME on HPC nodes
    export MPLCONFIGDIR=/tmp

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive

    # procps: `ps` for Nextflow task metrics
    apt-get update
    apt-get install -y --no-install-recommends procps
    rm -rf /var/lib/apt/lists/*

    pip install --no-cache-dir --upgrade pip
    pip install --no-cache-dir \
        "numpy=={{ NUMPY_VERSION }}" \
        "pandas=={{ PANDAS_VERSION }}" \
        "pyarrow=={{ PYARROW_VERSION }}"

%test
    set -e
    python3 - <<'EOF'
import sys, numpy, pandas, pyarrow, pyarrow.parquet
print("python ", sys.version.split()[0])
print("numpy  ", numpy.__version__)
print("pandas ", pandas.__version__)
print("pyarrow", pyarrow.__version__)
EOF

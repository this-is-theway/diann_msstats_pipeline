/*
========================================================================================
    DIA-NN Proteomics Pipeline — nextflow.config
========================================================================================
*/

/*
----------------------------------------------------------------------------------------
    Default parameters
----------------------------------------------------------------------------------------
*/

params {

    // ---- Input / Output ----
    input                = ''          // Glob to MS files, e.g. '/data/raw/*.mzML'
    fasta                = ''          // Protein FASTA database
    experimental_design  = ''          // CSV: file, experiment, bioreplicate, data_type
    outdir               = 'results'

    // ---- DIA-NN search ----
    diann_report         = ''          // if set, skip RAW_TO_MZML/DIANN and convert this report.parquet
    convert_raw          = true        // convert .raw to mzML first (false: DIA-NN reads .raw natively)
    diann_threads        = 8
    diann_ram            = 20           // GB
    diann_mbr            = true         // match-between-runs (--reanalyse)
    diann_qvalue         = 0.01         // precursor q-value (search + msstats.csv filter)
    diann_missed_cleavages = 1
    diann_min_pep_len    = 7
    diann_max_pep_len    = 30
    diann_min_pr_charge  = 1
    diann_max_pr_charge  = 4
    diann_min_pr_mz      = 300
    diann_max_pr_mz      = 1200
    diann_min_fr_mz      = 200
    diann_max_fr_mz      = 1800
    diann_max_var_mods   = 1
    diann_oxidation      = true         // variable Met oxidation
    diann_extra_args     = ''           // any additional DIA-NN command-line options

    // ---- report.parquet -> msstats.csv (MSstats DIANNtoMSstatsFormat) ----
    diann_pg_qvalue        = 0.01
    diann_global_qvalue    = 0.01                 // Global.* (or Lib.* with MBR) q-values

    // ---- MSstats / R analysis ----
    msstats_csv          = ''          // if set, skip RAW_TO_MZML/DIANN/DIANN_TO_MSSTATS and use this file
    protein_map          = ''          // (Optional, with msstats_csv) protein_map.csv from DIANN_TO_MSSTATS
    rmd_template         = ''          // Path to run_msstats.Rmd
    scripts              = ''          // Path to R scripts directory
    comparisons_file     = ''          // CSV: condition_A, condition_B
    highlight_genes_file = ''          // (Optional) one gene name per line
    imputation_method    = 'ludovic'      
    fdr_threshold        = 0.05
    log2fc_threshold     = 1            // |log2FC| cut-off (1 = 2-fold change)

    // ---- Report ----
    report_title         = 'Proteomics Analysis Report'
    report_author        = 'Author Name'
    logo_path            = ''

    // ---- Local tool path ----
    diann_bin            = 'diann'          // DIA-NN executable (e.g. 'diann-linux' or full path)

    // ---- Pipeline options ----
    help                 = false
    max_cpus             = 12
    max_memory           = '48.GB'
    max_time             = '72.h'

    // ---- SLURM (used with -profile slurm) ----
    slurm_queue           = ''          // partition (sbatch --partition); empty = cluster default
    slurm_account         = ''          // account to charge (sbatch --account); empty = user default
    slurm_queue_size      = 20          // max number of jobs queued/running at the same time
    slurm_submit_rate     = '10 sec'    // job submission rate limit
    slurm_cluster_options = ''          // any extra sbatch options, e.g. '--qos=normal --exclude=node01'

    // ---- Containers
    container_dir       = "${projectDir}/containers/"
}


/*
----------------------------------------------------------------------------------------
    Process configuration by label
----------------------------------------------------------------------------------------
*/

process {

    // Defaults for all processes
    errorStrategy = 'retry'
    maxRetries    = 2

    withLabel: 'process_low' {
        cpus   = 2
        memory = '4.GB'
        time   = '1.h'
    }

    withLabel: 'process_medium' {
        cpus   = 12
        memory = '48.GB'
        time   = '8.h'
    }

    withLabel: 'process_high' {
        cpus   = { params.diann_threads }
        memory = { "${params.diann_ram}.GB" }
        time   = '48.h'
    }

    // ---- Container assignments per process ----
    withName: 'RAW_TO_MZML' {
        container = "${params.container_dir}/thermorawfileparser/thermorawfileparser_1.4.5.sif"
    }

    withName: 'DIANN' {
        container = "${params.container_dir}/diann/diann_2.sif"            // TODO: set your DIA-NN image
    }

    withName: 'DIANN_TO_MSSTATS' {
        container = "${params.container_dir}/msstats/msstats.sif"          // needs MSstatsAlt + arrow
    }

    withName: 'MSSTATS_REPORT' {
        container = "${params.container_dir}/msstats/msstats.sif"
    }
}

/*
----------------------------------------------------------------------------------------
    Container engine
----------------------------------------------------------------------------------------
*/

apptainer {
    enabled    = true
}

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------

/*
    Usage:  nextflow run main.nf -profile local
            nextflow run main.nf -profile slurm
*/

profiles {
    local {
        executor {
            name   = 'local'
        }
    }

    slurm {
        executor {
            name            = 'slurm'
            queueSize       = params.slurm_queue_size
            submitRateLimit = params.slurm_submit_rate
        }
        process {
            executor       = 'slurm'
            queue          = params.slurm_queue ?: null
            clusterOptions = [
                params.slurm_account ? "--account=${params.slurm_account}" : '',
                params.slurm_cluster_options ?: ''
            ].findAll { it }.join(' ') ?: null
        }
    }
}

/*
----------------------------------------------------------------------------------------
    Execution reports
----------------------------------------------------------------------------------------
*/

report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report_${new java.util.Date().format('yyyy-MM-dd_HH-mm')}.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline_${new java.util.Date().format('yyyy-MM-dd_HH-mm')}.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace_${new java.util.Date().format('yyyy-MM-dd_HH-mm')}.txt"
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,workdir'
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag_${new java.util.Date().format('yyyy-MM-dd_HH-mm')}.html"
}

/*
----------------------------------------------------------------------------------------
    Manifest — pipeline metadata
----------------------------------------------------------------------------------------
*/

manifest {
    name            = 'diann-proteomics-pipeline'
    author          = 'Autor Name'
    description     = 'Nextflow pipeline: DIA-NN search → MSstats analysis → HTML report'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0'
}
